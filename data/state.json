      "summary": "Grow on YouTube, IG & TikTok",
      "icon": "https://files.openai.com/content?id=file_0000000087f08230891ee4bba06b1d21&cdn=1&cp=pi&ma=30672000&ts=0&p=pi&cid=8&sig=6de9f8548509fdace4dbd79b69515ae395b5a157eb3f2fc0d2bf4d16cb3a883b&v=0",
