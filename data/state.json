      "summary": "Connect 350+ data sources",
      "icon": "https://files.openai.com/content?id=file_00000000c678822fac3083e74fefb45f&cdn=1&cp=pi&ma=30672000&ts=0&p=pi&cid=1&sig=955ee725d5b8a81fd1b39f5b06fd86c70231a0e28392418bff13654c082bac34&v=0",
