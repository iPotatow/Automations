    "plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c": {
      "id": "plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c",
      "url": "https://chatgpt.com/plugins/plugin_asdk_app_69312da8e4dc81919370cb86fd172b6c",
      "name": "Adobe",
      "summary": "Design, combine, and edit",
      "icon": "https://files.openai.com/content?id=file_0000000000b4720ca05473965adda507&cdn=1&cp=pi&ma=31017600&ts=0&p=pi&cid=1&sig=9c83a384615d57139ad7d061085b80c28688ba0a35d60b1bf150a24d56b4546d&v=0",
      "categories": [
        "new-and-noteworthy",
