      "summary": "Manage projects, tasks & CRM",
      "icon": "https://files.openai.com/content?id=file_00000000cb7081f4ad57f20aa1312ba2&cdn=1&cp=pi&ma=30758400&ts=0&p=pi&cid=8&sig=1416f503053cf4cfa8b2076111fcb02fcd56eb83fd891a04c3368d0db37e363f&v=0",
