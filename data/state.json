      "summary": "Add your meeting context",
      "icon": "https://files.openai.com/content?id=file_00000000591471f69a7ca95a1d2a0127&cdn=1&cp=pi&ma=30153600&ts=0&p=pi&cid=1&sig=4eea39ddbc017575a5b3b92e4b2e85d8b953140e2fe832b4b713f6de01a9e59a",
